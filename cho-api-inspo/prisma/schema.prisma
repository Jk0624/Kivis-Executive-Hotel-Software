// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuthProvider {
  PHONE
  EMAIL
  GOOGLE
  APPLE
}

enum CodeType {
  ACTIVATION
  RESET
  LOGIN
}

enum OrderPaymentMethod {
  PREPAID
  CASH_ON_DELIVERY
  PAY_FOR_ME
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PayoutMethod {
  BANK
  MOMO
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  CLOSED
  PENDING
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  E_BIKE
  CAR
  TRUCK
  MINI_TRUCK
  TRICYCLE
  FOOT
}

enum AddonTag {
  main
  sauce
  sides
  packaging
}

enum FrontendComponent {
  checkbox
  slider
  counter
}

model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  foods Food[]

  @@index([isActive])
  @@index([slug])
  @@map("categories")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  RIDER_ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum CouponSource {
  REFUND
  ADMIN
}

enum NotificationAudience {
  USER
  VENDOR
  RIDER
  ALL
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE
}

enum AppActorType {
  USER
  VENDOR
  RIDER
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED

  @@map("withdrawal_status")
}

model User {
  id              BigInt       @id @default(autoincrement())
  firstName       String?      @map("first_name") @db.VarChar(100)
  lastName        String?      @map("last_name") @db.VarChar(100)
  email           String?      @unique @db.VarChar(255)
  phone           String?      @unique @db.VarChar(20)
  googleId        String?      @unique @map("google_id") @db.VarChar(255)
  appleId         String?      @unique @map("apple_id") @db.VarChar(255)
  password        String?      @db.VarChar(255) // Nullable for social login
  gender          Gender?
  dob             DateTime?    @db.Date
  authProvider    AuthProvider @default(PHONE) @map("auth_provider")
  emailVerifiedAt DateTime?    @map("email_verified_at")
  phoneVerifiedAt DateTime?    @map("phone_verified_at")
  isActive        Boolean      @default(true) @map("is_active")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  addresses          UserAddress[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]
  searchHistory      SearchHistory[]
  favorites          FavoriteFood[]
  orders             Order[]
  coupons            Coupon[]
  couponRedemptions  CouponRedemption[]

  @@index([isActive, deletedAt])
  @@map("users")
}

model Vendor {
  id              BigInt       @id @default(autoincrement())
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String       @map("last_name") @db.VarChar(100)
  email           String?      @unique @db.VarChar(255)
  phone           String       @unique @db.VarChar(20)
  password        String?      @db.VarChar(255)
  gender          Gender?
  nationality     String?      @db.VarChar(100)
  dob             DateTime?    @db.Date
  authProvider    AuthProvider @default(PHONE) @map("auth_provider")
  googleId        String?      @unique @map("google_id") @db.VarChar(255)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  phoneVerifiedAt DateTime?    @map("phone_verified_at")
  isActive               Boolean   @default(true) @map("is_active")
  isPersonalInfoComplete Boolean   @default(false) @map("is_personal_info_complete")
  deletionRequestedAt    DateTime? @map("deletion_requested_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  restaurants   Restaurant[]
  notifications Notification[]
  deviceTokens  DeviceToken[]

  @@map("vendors")
}

model Rider {
  id                     BigInt             @id @default(autoincrement())
  firstName              String             @map("first_name") @db.VarChar(100)
  lastName               String             @map("last_name") @db.VarChar(100)
  email                  String?            @unique @db.VarChar(255)
  phone                  String             @unique @db.VarChar(20)
  password               String?            @db.VarChar(255)
  gender                 Gender?
  nationality            String?            @db.VarChar(100)
  dob                    DateTime?          @db.Date
  authProvider           AuthProvider       @default(PHONE) @map("auth_provider")
  googleId               String?            @unique @map("google_id") @db.VarChar(255)
  emailVerifiedAt        DateTime?          @map("email_verified_at")
  phoneVerifiedAt        DateTime?          @map("phone_verified_at")
  isActive               Boolean            @default(true) @map("is_active")
  isOnline               Boolean            @default(false) @map("is_online")
  deletionRequestedAt    DateTime?          @map("deletion_requested_at")
  isPersonalInfoComplete Boolean            @default(false) @map("is_personal_info_complete")
  isPaymentInfoComplete  Boolean            @default(false) @map("is_payment_info_complete")
  verificationStatus     VerificationStatus @default(PENDING) @map("verification_status")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  // Relations
  vehicleInfo         RiderVehicleInfo?
  paymentDetails      RiderPaymentDetail[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  orders              Order[]
  withdrawalRequests  RiderWithdrawalRequest[]

  @@index([isActive, deletionRequestedAt])
  @@map("riders")
}

model RiderVehicleInfo {
  id           BigInt       @id @default(autoincrement())
  riderId      BigInt       @unique @map("rider_id")
  idFrontKey   String?      @map("id_front_key") @db.VarChar(500)
  idBackKey    String?      @map("id_back_key") @db.VarChar(500)
  vehicleType  VehicleType? @map("vehicle_type")
  vehicleBrand String?      @map("vehicle_brand") @db.VarChar(100)
  numberPlate  String?      @map("number_plate") @db.VarChar(50)
  isInfoComplete Boolean    @default(false) @map("is_info_complete")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rider_vehicle_info")
}

model RiderPaymentDetail {
  id            BigInt       @id @default(autoincrement())
  riderId       BigInt       @map("rider_id")
  method        PayoutMethod @default(MOMO)
  bankName      String?      @map("bank_name") @db.VarChar(100)
  network       String?      @db.VarChar(50)
  phone         String?      @db.VarChar(20)
  accountName   String       @map("account_name") @db.VarChar(200)
  accountNumber String?      @map("account_number") @db.VarChar(50)
  isDefault     Boolean      @default(false) @map("is_default")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rider_payment_details")
}

model VerificationCode {
  id         BigInt   @id @default(autoincrement())
  identifier String   @db.VarChar(255) // Email or Phone
  code       String   @db.VarChar(6)
  type       CodeType @default(ACTIVATION)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier])
  @@map("verification_codes")
}

model VerificationAttempt {
  id         BigInt   @id @default(autoincrement())
  identifier String   @db.VarChar(255) // Email or Phone
  ipAddress  String   @map("ip_address") @db.VarChar(45) // IPv4 or IPv6
  attempts   Int      @default(1)
  lastAttempt DateTime @default(now()) @map("last_attempt")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([identifier, ipAddress])
  @@index([identifier])
  @@index([ipAddress])
  @@index([lastAttempt])
  @@map("verification_attempts")
}

model UserAddress {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  label       String?  @default("Home") @db.VarChar(50)
  addressLine String   @map("address_line") @db.Text
  latitude    Decimal  @db.Decimal(10, 8)
  longitude   Decimal  @db.Decimal(11, 8)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt?   @map("user_id") // Nullable for system-wide alerts
  vendorId  BigInt?   @map("vendor_id")
  riderId   BigInt?   @map("rider_id")
  targetAudience NotificationAudience? @map("target_audience")
  title     String    @db.VarChar(150)
  message   String    @db.Text
  type      String    @default("general") @db.VarChar(50)
  metadata  Json? // Flexible JSON data
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rider  Rider?  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([targetAudience, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        BigInt  @id @default(autoincrement())
  userId    BigInt? @map("user_id")
  vendorId  BigInt? @map("vendor_id")
  riderId   BigInt? @map("rider_id")
  pushToken String  @map("push_token") @db.VarChar(255)
  platform  String  @db.VarChar(20)

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rider  Rider?  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vendorId])
  @@index([riderId])
  @@map("device_tokens")
}

model SearchHistory {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  searchTerm String   @map("search_term") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_history")
}

model Restaurant {
  id                    BigInt             @id @default(autoincrement())
  vendorId              BigInt?            @map("vendor_id")
  name                  String             @db.VarChar(255)
  type                  String?            @db.VarChar(100)
  description           String?            @db.Text
  phone                 String?            @db.VarChar(20)
  email                 String?            @db.VarChar(255)
  addressLine           String             @map("address_line") @db.Text
  latitude              Decimal            @db.Decimal(10, 8)
  longitude             Decimal            @db.Decimal(11, 8)
  imageUrl              String?            @map("image_url") @db.VarChar(500)
  rating                Decimal?           @default(0) @db.Decimal(3, 2) // 0.00 to 5.00
  status                RestaurantStatus   @default(PENDING)
  isInfoComplete        Boolean            @default(false) @map("is_info_complete")
  isPaymentInfoComplete Boolean            @default(false) @map("is_payment_info_complete")
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  isPopular             Boolean            @default(false) @map("is_popular")
  platformCommission    Decimal            @default(0) @map("platform_commission") @db.Decimal(5, 4)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  // Relations
  vendor              Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  foods               Food[]
  addons              Addon[]
  orders              Order[]
  operatingHours      OperatingHour[]
  paymentDetails      RestaurantPaymentDetail[]
  withdrawalRequests  VendorWithdrawalRequest[]

  @@index([vendorId])
  @@index([status])
  @@index([verificationStatus])
  @@index([isPopular])
  @@index([latitude])
  @@index([longitude])
  @@map("restaurants")
}

model OperatingHour {
  id           BigInt    @id @default(autoincrement())
  restaurantId BigInt    @map("restaurant_id")
  day          DayOfWeek
  openingTime  String    @map("opening_time") @db.VarChar(10) // "08:00"
  closingTime  String    @map("closing_time") @db.VarChar(10) // "22:00"
  isClosed     Boolean   @default(false) @map("is_closed")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, day])
  @@map("operating_hours")
}

model RestaurantPaymentDetail {
  id            BigInt       @id @default(autoincrement())
  restaurantId  BigInt       @map("restaurant_id")
  method        PayoutMethod @default(MOMO)
  bankName      String?      @map("bank_name") @db.VarChar(100)
  network       String?      @db.VarChar(50) // MTN, Telecel, AirtelTigo (for MOMO)
  phone         String?      @db.VarChar(20) // MoMo number
  accountName   String       @map("account_name") @db.VarChar(200)
  accountNumber String?      @map("account_number") @db.VarChar(50)
  isDefault     Boolean      @default(false) @map("is_default")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_payment_details")
}

model Food {
  id                BigInt     @id @default(autoincrement())
  restaurantId      BigInt     @map("restaurant_id")
  categoryId        BigInt?    @map("category_id")
  name              String     @db.VarChar(255)
  description       String?    @db.Text
  price             Decimal    @db.Decimal(10, 2)
  imageUrl          String?    @map("image_url") @db.VarChar(500)
  isAvailable       Boolean    @default(true) @map("is_available")
  isPopular         Boolean    @default(false) @map("is_popular")
  requiredAddonTags AddonTag[] @default([])
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  favorites  FavoriteFood[]
  addons     FoodAddon[]
  packs      FoodPack[]
  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([isPopular])
  @@map("foods")
}

model FavoriteFood {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  foodId    BigInt   @map("food_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([userId])
  @@index([foodId])
  @@map("favorite_foods")
}

model Addon {
  id                BigInt            @id @default(autoincrement())
  restaurantId      BigInt            @map("restaurant_id")
  name              String            @db.VarChar(255)
  description       String?           @db.Text
  price             Decimal           @default(0) @db.Decimal(10, 2)
  tag               AddonTag          @default(packaging)
  frontendComponent FrontendComponent @default(counter) @map("frontend_component")
  step              Decimal?          @db.Decimal(10, 2)
  minPrice          Decimal?          @map("min_price") @db.Decimal(10, 2)
  maxPrice          Decimal?          @map("max_price") @db.Decimal(10, 2)
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodAddons      FoodAddon[]
  orderItemAddons OrderItemAddon[]

  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@index([tag])
  @@map("addons")
}

model FoodAddon {
  id          BigInt   @id @default(autoincrement())
  foodId      BigInt   @map("food_id")
  addonId     BigInt   @map("addon_id")
  isRequired  Boolean  @default(false) @map("is_required")
  maxQuantity Int?     @map("max_quantity")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  food  Food  @relation(fields: [foodId], references: [id], onDelete: Cascade)
  addon Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([foodId, addonId])
  @@index([foodId])
  @@index([addonId])
  @@map("food_addons")
}

model FoodPack {
  id        BigInt   @id @default(autoincrement())
  foodId    BigInt   @map("food_id")
  name      String   @db.VarChar(255)
  price     Decimal  @db.Decimal(10, 2)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  food       Food        @relation(fields: [foodId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([foodId, name])
  @@index([foodId])
  @@index([foodId, isActive])
  @@map("food_packs")
}

model Order {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @map("user_id")
  restaurantId    BigInt        @map("restaurant_id")
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  deliveryAddress   String        @map("delivery_address") @db.Text
  deliveryLatitude  Decimal?      @map("delivery_latitude") @db.Decimal(10, 8)
  deliveryLongitude Decimal?      @map("delivery_longitude") @db.Decimal(11, 8)
  deliveryFee       Decimal       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  foodTotal         Decimal       @default(0) @map("food_total") @db.Decimal(10, 2)
  serviceFee        Decimal       @default(0) @map("service_fee") @db.Decimal(10, 2)
  tax               Decimal       @default(0) @map("tax") @db.Decimal(10, 2)
  orderNumber       String?       @unique @map("order_number") @db.VarChar(20)
  riderId         BigInt?       @map("rider_id")
  adminDispatchedById BigInt?   @map("admin_dispatched_by_id")

  restaurantNote     String?            @map("restaurant_note") @db.Text
  riderNote          String?            @map("rider_note") @db.Text
  deliveryPin        String?            @map("delivery_pin") @db.VarChar(6)
  orderPaymentMethod OrderPaymentMethod @default(PREPAID) @map("order_payment_method")
  paymentStatus      PaymentStatus      @default(PENDING) @map("payment_status")
  couponId           BigInt?            @map("coupon_id")
  discount             Decimal            @default(0) @map("discount") @db.Decimal(10, 2)
  vendorCommissionRate Decimal            @default(0) @map("vendor_commission_rate") @db.Decimal(5, 4)
  riderEarningPercent  Decimal?           @map("rider_earning_percent") @db.Decimal(5, 4)
  deliveredAt          DateTime?          @map("delivered_at")
  paidAt               DateTime?          @map("paid_at")
  delayNotifiedAt      DateTime?          @map("delay_notified_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant          Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rider               Rider?            @relation(fields: [riderId], references: [id], onDelete: SetNull)
  adminDispatchedBy   Admin?            @relation(fields: [adminDispatchedById], references: [id], onDelete: SetNull)
  coupon              Coupon?           @relation("OrderCoupon", fields: [couponId], references: [id], onDelete: SetNull)
  orderItems          OrderItem[]
  transactions        Transaction[]
  couponRedemption    CouponRedemption?
  sourceCoupon        Coupon?           @relation("CouponSourceOrder")
  payForMeLink        PayForMeLink?

  @@index([userId])
  @@index([restaurantId])
  @@index([riderId])
  @@index([adminDispatchedById])
  @@index([status])
  @@index([orderNumber])
  @@index([userId, status])
  @@index([couponId])
  @@index([status, paidAt])
  @@index([status, createdAt])
  @@index([status, delayNotifiedAt])
  @@map("orders")
}


model OrderItem {
  id         BigInt    @id @default(autoincrement())
  orderId    BigInt    @map("order_id")
  foodId     BigInt    @map("food_id")
  foodPackId BigInt?   @map("food_pack_id")
  quantity   Int
  price      Decimal   @db.Decimal(10, 2) // Snapshot at order time
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  food            Food             @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodPack        FoodPack?         @relation(fields: [foodPackId], references: [id], onDelete: SetNull)
  orderItemAddons OrderItemAddon[]

  @@index([orderId])
  @@index([foodId])
  @@index([foodPackId])
  @@map("order_items")
}

model OrderItemAddon {
  id          BigInt   @id @default(autoincrement())
  orderItemId BigInt   @map("order_item_id")
  addonId     BigInt   @map("addon_id")
  quantity    Int
  price       Decimal  @db.Decimal(10, 2) // Snapshot at order time
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon     Addon     @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, addonId])
  @@index([orderItemId])
  @@index([addonId])
  @@map("order_item_addons")
}

model Transaction {
  id                BigInt            @id @default(autoincrement())
  orderId           BigInt            @map("order_id")
  providerReference String            @unique @map("provider_reference") @db.VarChar(255)
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("GHS") @db.VarChar(3)
  status            TransactionStatus @default(PENDING)
  providerResponse  Json?             @map("provider_response")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerReference])
  @@index([status])
  @@map("transactions")
}

model PlatformConfig {
  id                      Int      @id @default(1)
  serviceFeePercent       Decimal  @default(0.0500) @map("service_fee_percent") @db.Decimal(5, 4)
  serviceFeeCap           Decimal  @default(5.00) @map("service_fee_cap") @db.Decimal(10, 2)
  taxRate                 Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4)
  riderDeliveryFeePercent Decimal  @default(0.7000) @map("rider_delivery_fee_percent") @db.Decimal(5, 4)
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

model DeliveryFeeTier {
  id            Int      @id @default(autoincrement())
  maxDistanceKm Decimal  @map("max_distance_km") @db.Decimal(6, 2)
  fee           Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([maxDistanceKm])
  @@map("delivery_fee_tiers")
}

model AppVersion {
  id             Int      @id @default(autoincrement())
  app            String   @db.VarChar(20) // "user" | "rider" | "vendor"
  platform       String   @db.VarChar(10) // "ios" | "android"
  latestVersion  String   @map("latest_version") @db.VarChar(20)
  minimumVersion String   @map("minimum_version") @db.VarChar(20)
  storeUrl       String   @map("store_url") @db.VarChar(500)
  updateMessage  String   @default("A new version is available. Please update for the best experience.") @map("update_message") @db.VarChar(500)
  forceMessage   String   @default("This version is no longer supported. Please update to continue.") @map("force_message") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([app, platform])
  @@map("app_versions")
}

model Coupon {
  id               BigInt       @id @default(autoincrement())
  code             String       @unique @db.VarChar(50)
  type             CouponType   @default(FIXED)
  source           CouponSource @default(ADMIN)

  value            Decimal      @db.Decimal(10, 2)
  maxDiscount      Decimal?     @map("max_discount") @db.Decimal(10, 2)
  minOrderAmount   Decimal?     @map("min_order_amount") @db.Decimal(10, 2)

  balance          Decimal?     @db.Decimal(10, 2)

  isOneTimePerUser Boolean      @default(true) @map("is_one_time_per_user")
  maxTotalUses     Int?         @map("max_total_uses")

  userId           BigInt?      @map("user_id")
  user             User?        @relation(fields: [userId], references: [id])

  sourceOrderId    BigInt?      @unique @map("source_order_id")
  sourceOrder      Order?       @relation("CouponSourceOrder", fields: [sourceOrderId], references: [id])

  expiresAt        DateTime     @map("expires_at")
  isActive         Boolean      @default(true) @map("is_active")

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  redemptions      CouponRedemption[]
  appliedOrders    Order[]      @relation("OrderCoupon")

  @@index([userId])
  @@index([code])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id             BigInt   @id @default(autoincrement())
  couponId       BigInt   @map("coupon_id")
  orderId        BigInt   @unique @map("order_id")
  userId         BigInt   @map("user_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

model PayForMeLink {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt   @unique @map("order_id")
  token      String   @unique @db.VarChar(64)
  payerName  String?  @map("payer_name") @db.VarChar(200)
  payerEmail String?  @map("payer_email") @db.VarChar(255)
  payerPhone String?  @map("payer_phone") @db.VarChar(20)
  isUsed     Boolean  @default(false) @map("is_used")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([orderId])
  @@index([expiresAt])
  @@map("pay_for_me_links")
}

model VendorWithdrawalRequest {
  id            BigInt           @id @default(autoincrement())
  restaurantId  BigInt           @map("restaurant_id")
  amount        Decimal          @db.Decimal(10, 2)
  status        WithdrawalStatus @default(PENDING)
  method        String           @db.VarChar(10)
  accountName   String           @map("account_name") @db.VarChar(200)
  accountNumber String?          @map("account_number") @db.VarChar(50)
  bankName      String?          @map("bank_name") @db.VarChar(100)
  network       String?          @db.VarChar(50)
  phone         String?          @db.VarChar(20)
  adminNote     String?          @map("admin_note") @db.Text
  processedAt   DateTime?        @map("processed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
  @@map("vendor_withdrawal_requests")
}

model RiderWithdrawalRequest {
  id            BigInt           @id @default(autoincrement())
  riderId       BigInt           @map("rider_id")
  amount        Decimal          @db.Decimal(10, 2)
  status        WithdrawalStatus @default(PENDING)
  method        String           @db.VarChar(10)
  accountName   String           @map("account_name") @db.VarChar(200)
  accountNumber String?          @map("account_number") @db.VarChar(50)
  bankName      String?          @map("bank_name") @db.VarChar(100)
  network       String?          @db.VarChar(50)
  phone         String?          @db.VarChar(20)
  adminNote     String?          @map("admin_note") @db.Text
  processedAt   DateTime?        @map("processed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
  @@map("rider_withdrawal_requests")
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model Admin {
  id        BigInt    @id @default(autoincrement())
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  role      AdminRole @default(SUPPORT)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  auditLogs        AdminAuditLog[]
  dispatchedOrders Order[]
  inviteTokens     AdminInviteToken[]

  @@index([email])
  @@index([role])
  @@map("admins")
}

model AdminInviteToken {
  id        BigInt    @id @default(autoincrement())
  adminId   BigInt    @map("admin_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_invite_tokens")
}

model AdminAuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    BigInt   @map("admin_id")
  action     String   @db.VarChar(100)  // e.g. "APPROVE_RIDER", "BLOCK_USER"
  targetType String   @map("target_type") @db.VarChar(50)  // "rider" | "vendor" | "user" | "order"
  targetId   String   @map("target_id") @db.VarChar(50)
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model AppAuditLog {
  id         BigInt       @id @default(autoincrement())
  actorType  AppActorType @map("actor_type")
  actorId    BigInt       @map("actor_id")
  action     String       @db.VarChar(120)
  targetType String       @map("target_type") @db.VarChar(80)
  targetId   String?      @map("target_id") @db.VarChar(80)
  method     String       @db.VarChar(10)
  path       String       @db.VarChar(500)
  statusCode Int          @map("status_code")
  meta       Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
  @@map("app_audit_logs")
}

// ─── Banners ──────────────────────────────────────────────────────────────────

model Banner {
  id           BigInt   @id @default(autoincrement())
  title        String   @db.VarChar(150)
  imageUrl     String   @map("image_url") @db.VarChar(500)
  link         String?  @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("banners")
}
